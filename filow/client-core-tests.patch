@@ -574,6 +574,58 @@ mod tests {
         assert_eq!(traffic.sessions.len(), 1);
     }
 
+    // Issue #106: a reaction leaves the device Megolm-encrypted like any
+    // other event. The account's other devices drop a clear reaction in an
+    // encrypted room (the homeserver could have forged it), so one sent in
+    // clear is lost everywhere but in the sender's local echo. Its relation
+    // stays in the clear envelope as well, as the spec requires, for the
+    // server to aggregate it.
+    #[tokio::test]
+    async fn a_reaction_in_an_encrypted_room_is_encrypted() {
+        let server = homeserver().await;
+        let (client, _store) = logged_in_client(&server).await;
+        encrypted_room(
+            &server,
+            &client,
+            &[
+                owner(vec![(ALLOWED_DEVICE, Signed::Yes)]),
+                Member::cross_signed(BOT, vec![(BOT_DEVICE, Signed::Yes)]),
+            ],
+            true,
+        )
+        .await;
+        let allowlist = OwnDeviceAllowlist::default();
+        allowlist
+            .set(vec![ALLOWED_DEVICE.to_owned()])
+            .expect("valid allowlist");
+
+        send_reaction(&client, &allowlist, ROOM, "$target", "👍")
+            .await
+            .expect("send");
+
+        let requests = server.received_requests().await.expect("recorded requests");
+        let sent: Vec<_> = requests
+            .iter()
+            .filter(|request| request.url.path().contains(&format!("/rooms/{ROOM}/send/")))
+            .collect();
+        assert_eq!(sent.len(), 1, "one event sent");
+        assert!(
+            sent[0].url.path().contains("/send/m.room.encrypted/"),
+            "sent as {}",
+            sent[0].url.path()
+        );
+        let envelope: serde_json::Value =
+            serde_json::from_slice(&sent[0].body).expect("JSON body");
+        assert_eq!(envelope["algorithm"], "m.megolm.v1.aes-sha2");
+        assert_eq!(
+            envelope["m.relates_to"],
+            json!({ "rel_type": "m.annotation", "event_id": "$target", "key": "👍" })
+        );
+        let traffic = sent_traffic(&requests);
+        assert!(traffic.keyed(BOT, BOT_DEVICE), "the bridge bot got the key");
+        assert!(traffic.keyed(OWN_USER, ALLOWED_DEVICE));
+    }
+
